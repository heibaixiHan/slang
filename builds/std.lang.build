@sexpr
; std.lang.build —— 标准库
;
; 对外仍然是可被任意覆盖的普通定义（map、reduce、range……），
; 但内部基础操作直接使用 %-原语：这样用户覆盖 `=`、`if`、`+`
; 这类用户级名字时，不会意外改坏标准库自身的逻辑。
;
; range/map/filter/reduce/take/drop 由解释器原语实现，
; 因此可以处理远超递归深度限制的大列表。

(defn range (start end)
  (%range start end))

(defn map (f xs)
  (%map f xs))

(defn filter (pred xs)
  (%filter pred xs))

(defn reduce (f acc xs)
  (%reduce f acc xs))

(defn sum (xs)
  (%reduce (fn (a b) (%add a b)) 0 xs))

(defn square (x) (%mul x x))
(defn not= (a b) (%ne a b))

(defn last (xs)
  (%nth xs (%sub (%len xs) 1)))

(defn take (n xs)
  (%take n xs))

(defn drop (n xs)
  (%drop n xs))
