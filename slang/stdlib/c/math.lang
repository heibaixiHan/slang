@sexpr
; C libm 的常用封装。
; 用法：(def math (import "c.math")) 然后 (math.sqrt 2)
(def _ffi (import "ffi"))
(def _m (_ffi.c "m"))

(def sqrt _m.sqrt)
(def cbrt _m.cbrt)
(def sin _m.sin)
(def cos _m.cos)
(def tan _m.tan)
(def asin _m.asin)
(def acos _m.acos)
(def atan _m.atan)
(def atan2 _m.atan2)
(def sinh _m.sinh)
(def cosh _m.cosh)
(def tanh _m.tanh)
(def exp _m.exp)
(def exp2 _m.exp2)
(def log _m.log)
(def log2 _m.log2)
(def log10 _m.log10)
(def pow _m.pow)
(def fabs _m.fabs)
(def floor _m.floor)
(def ceil _m.ceil)
(def round _m.round)
(def trunc _m.trunc)
(def fmod _m.fmod)
(def remainder _m.remainder)
(def hypot _m.hypot)
(def copysign _m.copysign)
(def fdim _m.fdim)
(def fmax _m.fmax)
(def fmin _m.fmin)
(def tgamma _m.tgamma)
(def lgamma _m.lgamma)
