@sexpr
; base.lang.build —— slang 语言的引导层
;
; 核心解释器只提供 % 开头的原子操作（%-原语）。
; 从这里开始，才有“用户可见的语言”：def、if、fn、add……
; 所有定义都放在同一个环境里，后加载的文件可以直接覆盖它们。

; ---------- 名称绑定 / 函数 ----------
; 第一行只能用 %-原语自举：此时环境里除了核心原语还什么都没有。
(%bind "def" (%lazy (name value) (%bind name (%eval value))))
(def set  (%lazy (name value) (%set name (%eval value))))
(def fn   (%lazy (params body...) (%lambda params body...)))
(def defn (%lazy (name params body...) (%bind name (%lambda params body...))))
(def defmacro (%lazy (name params body...) (%bind name (%lazy params body...))))
(def let  def)
(def lambda fn)
(def quote %quote)

; ---------- 常量 / 条件 ----------
(def nil ())            ; 空列表，同时作为“假”
(def true (%eq 1 1))    ; 布尔真
(def false (%eq 1 0))   ; 布尔假

; 直接绑定 %ifc，省掉一层宏帧（行为相同，递归深度更高）
(def if %ifc)

(def when (%lazy (cond then)
  (%ifc cond then ())))

; and/or 短路并返回实际值；条件与分支是同一表达式时直接复用已求值结果
(def and (%lazy (a b)
  (%ifc a b a)))

(def or (%lazy (a b)
  (%ifc a a b)))

; ---------- 数学习惯名（直接指向 %-原语）----------
(def add %add)
(def sub %sub)
(def mul %mul)
(def div %div)
(def mod %mod)
(def neg %neg)

(def + %add)
(def - %sub)
(def * %mul)
(def / %div)
(def % %mod)

(def =  %eq)
(def == %eq)
(def != %ne)
(def eq %eq)
(def <  %lt)
(def <= %le)
(def >  %gt)
(def >= %ge)

; ---------- 逻辑 / 列表 / 字符串 ----------
(def not %not)
(def list %list)
(def first %first)
(def rest %rest)
(def cons %cons)
(def nth %nth)
(def append %append)
(def sort %sort)
(def split %split)
(def join %join)
(def substr %substr)
(def len %len)
(def str %str)
(def num %num)
(def type %type)
(def concat %concat)
(def apply %apply)

; ---------- 输入输出 / 杂项 ----------
(def print %print)
(def println (%lambda (x) (%print (%concat x "\n"))))
(def readfile %readfile)
(def writefile %writefile)
(def error %error)

; ---------- 程序内加载 ----------
; (load "x.lang.build")           -> 覆盖模式：直接覆盖当前环境的定义
; (def m (import "x.lang.build")) -> 模块模式：返回独立模块，用 m.名字 访问
; (load-config "slang.toml")      -> 读取配置并按顺序加载 builds.files
(def load %load)
(def use %load)
(def import %import)
(def load-config %loadconfig)

; ---------- 顺序执行 ----------
(def do (%lazy (xs...) (%do xs)))
