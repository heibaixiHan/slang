@sexpr
; Python math 标准库的常用封装。
; 用法：(def math (import "python.math")) 然后 (math.sqrt 2)
(def _ffi (import "ffi"))
(def _math (_ffi.python "math"))

(def pi _math.pi)
(def e _math.e)
(def tau _math.tau)
(def inf _math.inf)
(def nan _math.nan)

(def sqrt _math.sqrt)
(def cbrt _math.cbrt)
(def pow _math.pow)
(def exp _math.exp)
(def log _math.log)
(def log2 _math.log2)
(def log10 _math.log10)
(def sin _math.sin)
(def cos _math.cos)
(def tan _math.tan)
(def asin _math.asin)
(def acos _math.acos)
(def atan _math.atan)
(def atan2 _math.atan2)
(def floor _math.floor)
(def ceil _math.ceil)
(def trunc _math.trunc)
(def fabs _math.fabs)
(def fmod _math.fmod)
(def hypot _math.hypot)
(def radians _math.radians)
(def degrees _math.degrees)
(def isnan _math.isnan)
(def isinf _math.isinf)
(def isfinite _math.isfinite)
